<Window x:Class="Seer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Seer.Controls"
        Title="Seer"
        Width="720" Height="520"
        MinWidth="520" MinHeight="400"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource SeerBackground}"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Custom chrome: remove default title bar, we draw our own -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{StaticResource SeerBackground}"
            BorderBrush="{StaticResource SeerBorder}"
            BorderThickness="1"
            CornerRadius="0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />   <!-- Title bar -->
                <RowDefinition Height="Auto" /> <!-- Status strip -->
                <RowDefinition Height="*" />    <!-- Main panels -->
            </Grid.RowDefinitions>

            <!-- ═══ Title Bar (32px) ═══ -->
            <Border Grid.Row="0"
                    Background="{StaticResource SeerPanel}"
                    BorderBrush="{StaticResource SeerBorder}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Wordmark -->
                    <TextBlock Grid.Column="0"
                               Text="SEER"
                               Style="{StaticResource WordmarkStyle}"
                               Margin="12,0,0,0" />

                    <!-- Window controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Content="─"
                                Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Content="□"
                                Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Content="✕"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Status Strip ═══ -->
            <Border Grid.Row="1"
                    Background="{StaticResource SeerPanel}"
                    BorderBrush="{StaticResource SeerBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU bar -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="CPU"
                                   Style="{StaticResource TagStyle}" Margin="0,0,0,3" />
                        <Grid>
                            <Border Style="{StaticResource StatusBarTrackStyle}" />
                            <Border x:Name="CpuStatusBar"
                                    Background="{StaticResource SeerAccent}"
                                    Height="4" CornerRadius="0"
                                    HorizontalAlignment="Left"
                                    Width="0" />
                        </Grid>
                    </StackPanel>

                    <!-- MEM bar -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="MEM"
                                   Style="{StaticResource TagStyle}" Margin="0,0,0,3" />
                        <Grid>
                            <Border Style="{StaticResource StatusBarTrackStyle}" />
                            <Border x:Name="MemStatusBar"
                                    Background="{StaticResource SeerAccentSecondary}"
                                    Height="4" CornerRadius="0"
                                    HorizontalAlignment="Left"
                                    Width="0" />
                        </Grid>
                    </StackPanel>

                    <!-- GPU bar -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="GPU"
                                   Style="{StaticResource TagStyle}" Margin="0,0,0,3" />
                        <Grid>
                            <Border Style="{StaticResource StatusBarTrackStyle}" />
                            <Border x:Name="GpuStatusBar"
                                    Background="{StaticResource SeerAccentTertiary}"
                                    Height="4" CornerRadius="0"
                                    HorizontalAlignment="Left"
                                    Width="0" />
                        </Grid>
                    </StackPanel>

                    <!-- Status badge -->
                    <Border x:Name="StatusBadgeBorder"
                            Grid.Column="3"
                            Background="#1A3DDC84"
                            BorderBrush="{StaticResource SeerSuccess}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadgeText"
                                   Text="NOMINAL"
                                   Style="{StaticResource TagStyle}"
                                   Foreground="{StaticResource SeerSuccess}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Main Panels ═══ -->
            <Grid Grid.Row="2" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="60" /> <!-- Trend Charts -->
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="Auto" /> <!-- Disk & Network I/O -->
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="Auto" /> <!-- Top Processes -->
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="Auto" /> <!-- Alerts -->
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="Auto" /> <!-- System Info (collapsed by default) -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" /> <!-- Gap -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- [1] CPU Panel -->
                <controls:HudPanel Grid.Row="0" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Panel header -->
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource SeerBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="[1] CPU"
                                           Style="{StaticResource PanelHeaderStyle}" />
                                <TextBlock x:Name="ElevateButton" Grid.Column="1"
                                           Text="RUN AS ADMIN"
                                           Style="{StaticResource TagStyle}"
                                           Foreground="{StaticResource SeerAccentSecondary}"
                                           Cursor="Hand"
                                           MouseDown="ElevateButton_Click"
                                           ToolTip="Relaunch as Administrator to read CPU Thermals/Power">
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                    To="{StaticResource BorderActiveColor}" Duration="0:0:0.120" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                    To="{StaticResource AccentSecondaryColor}" Duration="0:0:0.120" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Panel content — live values -->
                        <StackPanel Grid.Row="1" Margin="12,10,12,0">
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Temperature:  " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="CpuTempValue" Text="--" Foreground="{StaticResource SeerWarning}" /><Run x:Name="CpuTempUnit" Text=" °C" Foreground="{StaticResource SeerWarning}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Load:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="CpuLoadValue" Text="--" /><Run x:Name="CpuLoadUnit" Text=" %" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Clock:        " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="CpuClockValue" Text="--" Foreground="{StaticResource SeerWarning}" /><Run x:Name="CpuClockUnit" Text=" MHz" Foreground="{StaticResource SeerWarning}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}">
                                <Run Text="Power:        " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="CpuPowerValue" Text="--" Foreground="{StaticResource SeerWarning}" /><Run x:Name="CpuPowerUnit" Text=" W" Foreground="{StaticResource SeerWarning}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Per-core load bars -->
                        <ItemsControl x:Name="CpuCoreBarsControl" Grid.Row="2" Margin="12,10,12,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource BaseTextStyle}" Margin="0,0,8,2" Foreground="{StaticResource SeerTextDim}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </controls:HudPanel>

                <!-- [2] Memory Panel -->
                <controls:HudPanel Grid.Row="0" Grid.Column="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource SeerBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <TextBlock Text="[2] MEMORY"
                                       Style="{StaticResource PanelHeaderStyle}" />
                        </Border>

                        <StackPanel Grid.Row="1" Margin="12,10">
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Used:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="MemUsedValue" Text="-- / -- GB" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Load:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="MemLoadValue" Text="-- %" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}">
                                <Run Text="Available:    " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="MemAvailValue" Text="-- GB" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </controls:HudPanel>

                <!-- [3] GPU Panel (spans full width on bottom row) -->
                <controls:HudPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource SeerBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <TextBlock Text="[3] GPU"
                                       Style="{StaticResource PanelHeaderStyle}" />
                        </Border>

                        <Grid Grid.Row="1" Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Column 0 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Temperature:  " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuTempValue" Text="--" /><Run x:Name="GpuTempUnit" Text=" °C" />
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Load:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuLoadValue" Text="--" /><Run x:Name="GpuLoadUnit" Text=" %" />
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BaseTextStyle}">
                                <Run Text="Clock:        " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuClockValue" Text="--" /><Run x:Name="GpuClockUnit" Text=" MHz" />
                            </TextBlock>

                            <!-- Column 2 -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Hot Spot:     " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuHotSpotValue" Text="--" /><Run x:Name="GpuHotSpotUnit" Text=" °C" />
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Fan Speed:    " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuFanValue" Text="--" /><Run x:Name="GpuFanUnit" Text=" RPM" />
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource BaseTextStyle}">
                                <Run Text="VRAM:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuVramValue" Text="-- / -- GB" />
                            </TextBlock>
                        </Grid>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ Trend Charts ═══ -->
                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" /> <!-- Gap -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" /> <!-- Gap -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:TrendChart x:Name="CpuChart" Grid.Column="0" Title="CPU LOAD" Stroke="{StaticResource SeerAccent}" />
                    <controls:TrendChart x:Name="MemChart" Grid.Column="2" Title="MEM LOAD" Stroke="{StaticResource SeerAccentSecondary}" />
                    <controls:TrendChart x:Name="GpuChart" Grid.Column="4" Title="GPU LOAD" Stroke="{StaticResource SeerAccentTertiary}" />
                </Grid>

                <!-- ═══ Disk I/O Panel ═══ -->
                <controls:HudPanel Grid.Row="6" Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource SeerBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <TextBlock Text="[4] DISK I/O"
                                       Style="{StaticResource PanelHeaderStyle}" />
                        </Border>

                        <StackPanel Grid.Row="1" Margin="12,10,12,10">
                            <!-- Read -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Read" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="[" Foreground="{StaticResource SeerTextDim}" Style="{StaticResource BaseTextStyle}" />
                                    <TextBlock x:Name="DiskReadBar" Text="          " Style="{StaticResource BaseTextStyle}" xml:space="preserve" />
                                    <TextBlock Text="]" Foreground="{StaticResource SeerTextDim}" Style="{StaticResource BaseTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" x:Name="DiskReadValue" Text="-- MB/s" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            
                            <!-- Write -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Write" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="[" Foreground="{StaticResource SeerTextDim}" Style="{StaticResource BaseTextStyle}" />
                                    <TextBlock x:Name="DiskWriteBar" Text="          " Style="{StaticResource BaseTextStyle}" xml:space="preserve" />
                                    <TextBlock Text="]" Foreground="{StaticResource SeerTextDim}" Style="{StaticResource BaseTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" x:Name="DiskWriteValue" Text="-- MB/s" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ Network I/O Panel ═══ -->
                <controls:HudPanel Grid.Row="6" Grid.Column="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource SeerBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <TextBlock Text="[5] NETWORK I/O"
                                       Style="{StaticResource PanelHeaderStyle}" />
                        </Border>

                        <StackPanel Grid.Row="1" Margin="12,10,12,10">
                            <!-- Download -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Down" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="[" Foreground="{StaticResource SeerTextDim}" Style="{StaticResource BaseTextStyle}" />
                                    <TextBlock x:Name="NetDownBar" Text="          " Style="{StaticResource BaseTextStyle}" xml:space="preserve" />
                                    <TextBlock Text="]" Foreground="{StaticResource SeerTextDim}" Style="{StaticResource BaseTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" x:Name="NetDownValue" Text="-- Mbps" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            
                            <!-- Upload -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Up" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="[" Foreground="{StaticResource SeerTextDim}" Style="{StaticResource BaseTextStyle}" />
                                    <TextBlock x:Name="NetUpBar" Text="          " Style="{StaticResource BaseTextStyle}" xml:space="preserve" />
                                    <TextBlock Text="]" Foreground="{StaticResource SeerTextDim}" Style="{StaticResource BaseTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" x:Name="NetUpValue" Text="-- Mbps" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ Top Processes Panel ═══ -->
                <controls:HudPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource SeerBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <TextBlock Text="[6] TOP PROCESSES"
                                       Style="{StaticResource PanelHeaderStyle}" />
                        </Border>

                        <ItemsControl x:Name="TopProcessesControl" Grid.Row="1" Margin="12,10,12,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Name (truncated) -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Name}" 
                                                   Style="{StaticResource BaseTextStyle}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center" />
                                                   
                                        <!-- CPU Bar -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="[" Foreground="{StaticResource SeerTextDim}" Style="{StaticResource BaseTextStyle}" />
                                            <TextBlock Text="{Binding CpuBar}" Style="{StaticResource BaseTextStyle}" xml:space="preserve" />
                                            <TextBlock Text="{Binding CpuPercent, StringFormat={}{0,5:F1}%}" Style="{StaticResource BaseTextStyle}" Width="45" TextAlignment="Right" />
                                            <TextBlock Text="]" Foreground="{StaticResource SeerTextDim}" Style="{StaticResource BaseTextStyle}" />
                                        </StackPanel>
                                        
                                        <!-- RAM Value -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding WorkingSetMb, StringFormat={}{0,5:F0}MB}" 
                                                   Style="{StaticResource BaseTextStyle}" 
                                                   Foreground="{StaticResource SeerTextDim}" 
                                                   TextAlignment="Right" 
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ Alerts Panel (collapsed by default) ═══ -->
                <controls:HudPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Clickable header -->
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource SeerBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6"
                                Cursor="Hand"
                                MouseDown="AlertsHeader_Click">
                            <TextBlock x:Name="AlertsHeaderText"
                                       Text="[7] ALERTS ▸"
                                       Style="{StaticResource PanelHeaderStyle}" />
                        </Border>

                        <!-- Collapsible content -->
                        <ScrollViewer x:Name="AlertsContent" Grid.Row="1" Margin="12,10" MaxHeight="120" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <ItemsControl x:Name="AlertsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" /> <!-- Time -->
                                                <ColumnDefinition Width="80" /> <!-- Metric -->
                                                <ColumnDefinition Width="*" />  <!-- Value -->
                                                <ColumnDefinition Width="Auto" /> <!-- Severity Badge -->
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding MetricName}" Style="{StaticResource BaseTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedValue}" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" VerticalAlignment="Center" />
                                            
                                            <Border Grid.Column="3" 
                                                    BorderThickness="1" 
                                                    CornerRadius="9999" 
                                                    Padding="8,1" 
                                                    HorizontalAlignment="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource SeerWarning}" />
                                                        <Setter Property="Background" Value="#1AF59E0B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter Property="BorderBrush" Value="{StaticResource SeerDanger}" />
                                                                <Setter Property="Background" Value="#1AEF4444" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Severity}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TagStyle}">
                                                            <Setter Property="Foreground" Value="{StaticResource SeerWarning}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                    <Setter Property="Foreground" Value="{StaticResource SeerDanger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ System Info Panel (collapsed by default) ═══ -->
                <controls:HudPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Clickable header -->
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource SeerBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6"
                                Cursor="Hand"
                                MouseDown="SystemInfoHeader_Click">
                            <TextBlock x:Name="SystemInfoHeaderText"
                                       Text="[i] SYSTEM INFO ▸"
                                       Style="{StaticResource PanelHeaderStyle}" />
                        </Border>

                        <!-- Collapsible content -->
                        <StackPanel x:Name="SystemInfoContent" Grid.Row="1" Margin="12,10" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Motherboard:  " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysMotherboard" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="BIOS:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysBios" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="CPU:          " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysCpu" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Cores:        " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysCores" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="RAM:          " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysRam" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="DIMM Slots:   " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysDimmSlots" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}">
                                <Run Text="GPU:          " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysGpu" Text="--" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </controls:HudPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
