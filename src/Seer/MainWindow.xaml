<Window x:Class="Seer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Seer.Controls"
        Title="Seer"
        Icon="Assets/seer.ico"
        Width="720" Height="520"
        MinWidth="640" MinHeight="400"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource SeerBackground}"
        ResizeMode="CanResizeWithGrip"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Custom chrome: remove default title bar, we draw our own -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{StaticResource SeerBackground}"
            BorderBrush="{StaticResource SeerBorder}"
            BorderThickness="1"
            CornerRadius="0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />   <!-- Title bar -->
                <RowDefinition Height="Auto" /> <!-- Status strip -->
                <RowDefinition Height="*" />    <!-- Main panels -->
                <RowDefinition Height="Auto" /> <!-- Status line -->
            </Grid.RowDefinitions>

            <!-- ═══ Title Bar (32px) ═══ -->
            <Border Grid.Row="0"
                    Background="{StaticResource SeerPanel}"
                    BorderBrush="{StaticResource SeerBorder}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Wordmark + build version (so bug reports name a build) -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="SEER"
                                   Style="{StaticResource WordmarkStyle}"
                                   Margin="12,0,0,0" />
                        <TextBlock x:Name="VersionLabel"
                                   Style="{StaticResource TagStyle}"
                                   VerticalAlignment="Center"
                                   Margin="8,1,0,0" />

                        <!-- Also reachable from the tray menu; here so it's
                             findable without knowing the tray icon exists. -->
                        <TextBlock Text="SETTINGS"
                                   Style="{StaticResource TagStyle}"
                                   VerticalAlignment="Center"
                                   Margin="16,1,0,0"
                                   Cursor="Hand"
                                   ToolTip="Alert thresholds and startup"
                                   WindowChrome.IsHitTestVisibleInChrome="True"
                                   MouseLeftButtonUp="SettingsButton_Click">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                            To="{StaticResource AccentColor}" Duration="0:0:0.120" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                            To="{StaticResource TextDimColor}" Duration="0:0:0.120" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Content="─"
                                Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Content="□"
                                Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource CloseButtonStyle}"
                                Content="✕"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Status Strip ═══ -->
            <Border Grid.Row="1"
                    Background="{StaticResource SeerPanel}"
                    BorderBrush="{StaticResource SeerBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU bar -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="CPU" Style="{StaticResource TagStyle}" />
                            <TextBlock x:Name="CpuStatusValue"
                                       Style="{StaticResource TagStyle}"
                                       Foreground="{StaticResource SeerText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <controls:SegmentMeter x:Name="CpuStatusBar"
                                               Height="4"
                                               ShowTicks="True"
                                               Fill="{StaticResource SeerAccent}"
                                               TrackBrush="{StaticResource SeerMeterTrack}"
                                               WarnBrush="{StaticResource SeerWarning}"
                                               CritBrush="{StaticResource SeerDanger}"
                                               PeakBrush="{StaticResource SeerPeak}" />
                    </StackPanel>

                    <!-- MEM bar -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="MEM" Style="{StaticResource TagStyle}" />
                            <TextBlock x:Name="MemStatusValue"
                                       Style="{StaticResource TagStyle}"
                                       Foreground="{StaticResource SeerText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <controls:SegmentMeter x:Name="MemStatusBar"
                                               Height="4"
                                               ShowTicks="True"
                                               Fill="{StaticResource SeerAccentSecondary}"
                                               TrackBrush="{StaticResource SeerMeterTrack}"
                                               WarnBrush="{StaticResource SeerWarning}"
                                               CritBrush="{StaticResource SeerDanger}"
                                               PeakBrush="{StaticResource SeerPeak}" />
                    </StackPanel>

                    <!-- GPU bar -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="GPU" Style="{StaticResource TagStyle}" />
                            <TextBlock x:Name="GpuStatusValue"
                                       Style="{StaticResource TagStyle}"
                                       Foreground="{StaticResource SeerText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <controls:SegmentMeter x:Name="GpuStatusBar"
                                               Height="4"
                                               ShowTicks="True"
                                               Fill="{StaticResource SeerAccentTertiary}"
                                               TrackBrush="{StaticResource SeerMeterTrack}"
                                               WarnBrush="{StaticResource SeerWarning}"
                                               CritBrush="{StaticResource SeerDanger}"
                                               PeakBrush="{StaticResource SeerPeak}" />
                    </StackPanel>

                    <!-- Sample heartbeat, then the status badge -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Blinks once per completed poll. A frozen dot means
                             Seer has stopped sampling; a late poll turns it amber. -->
                        <Ellipse x:Name="HeartbeatDot"
                                 Width="6" Height="6"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource SeerSuccess}"
                                 Opacity="0.35" />

                        <TextBlock x:Name="PollLateText"
                                   Style="{StaticResource TagStyle}"
                                   Foreground="{StaticResource SeerWarning}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <Border x:Name="StatusBadgeBorder"
                                Background="{StaticResource SeerSuccessTint}"
                                BorderBrush="{StaticResource SeerSuccess}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,2"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatusBadgeText"
                                       Text="NOMINAL"
                                       Style="{StaticResource TagStyle}"
                                       Foreground="{StaticResource SeerSuccess}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Main Panels ═══ -->
            <!-- The panel stack is taller than the window once every
                 panel is expanded, so it scrolls. Panels below size to
                 their content (Auto rows) rather than sharing leftover
                 space, which is what previously crushed the CPU panel. -->
            <ScrollViewer Grid.Row="2"
                          Margin="12"
                          Style="{StaticResource SeerScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="64" /> <!-- Trend Charts -->
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="Auto" /> <!-- Disk & Network I/O -->
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="Auto" /> <!-- Top Processes -->
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="Auto" /> <!-- Ping -->
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="Auto" /> <!-- Alerts -->
                    <RowDefinition Height="12" /> <!-- Gap -->
                    <RowDefinition Height="Auto" /> <!-- System Info (collapsed by default) -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" /> <!-- Gap -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- [1] CPU Panel -->
                <controls:HudPanel x:Name="CpuPanel" Grid.Row="0" Grid.Column="0"
                                   IndexTag="[1]" Header="CPU">
                    <controls:HudPanel.HeaderContent>
                                <TextBlock x:Name="ElevateButton"
                                           Text="RUN AS ADMIN"
                                           Style="{StaticResource TagStyle}"
                                           Foreground="{StaticResource SeerAccentSecondary}"
                                           Background="{StaticResource SeerPanel}"
                                           Padding="4,0"
                                           VerticalAlignment="Center"
                                           Cursor="Hand"
                                           MouseDown="ElevateButton_Click"
                                           ToolTip="Relaunch as Administrator to read CPU Thermals/Power">
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                    To="{StaticResource BorderActiveColor}" Duration="0:0:0.120" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                    To="{StaticResource AccentSecondaryColor}" Duration="0:0:0.120" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                    </controls:HudPanel.HeaderContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Panel content — live values -->
                        <StackPanel Grid.Row="0" Margin="12,10,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource BaseTextStyle}">
                                    <Run Text="Temperature:  " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="CpuTempValue" Text="--" Foreground="{StaticResource SeerWarning}" /><Run x:Name="CpuTempUnit" Text=" °C" Foreground="{StaticResource SeerWarning}" />
                                </TextBlock>
                                <Path x:Name="CpuTempTrend" Width="7" Height="7" Stretch="Uniform"
                                      Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource BaseTextStyle}">
                                    <Run Text="Load:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="CpuLoadValue" Text="--" /><Run x:Name="CpuLoadUnit" Text=" %" />
                                </TextBlock>
                                <Path x:Name="CpuLoadTrend" Width="7" Height="7" Stretch="Uniform"
                                      Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Clock:        " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="CpuClockValue" Text="--" Foreground="{StaticResource SeerWarning}" /><Run x:Name="CpuClockUnit" Text=" MHz" Foreground="{StaticResource SeerWarning}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}">
                                <Run Text="Power:        " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="CpuPowerValue" Text="--" Foreground="{StaticResource SeerWarning}" /><Run x:Name="CpuPowerUnit" Text=" W" Foreground="{StaticResource SeerWarning}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Per-core load bars -->
                        <!-- Per-core load bars.
                             Each item is one whole ROW of text, composed in
                             UpdateCpuPanel from fixed-width cells. Threads
                             read top-to-bottom down each column, which a
                             panel of individual items can't do while also
                             reflowing — and because the font is monospace
                             and every cell is exactly 13 characters, the
                             columns align by construction rather than by
                             layout. The default vertical StackPanel gives
                             each row its natural height, so nothing can
                             overlap however short the panel gets. -->
                        <controls:CoreMatrix x:Name="CpuCoreMatrix" Grid.Row="1" Margin="12,10,12,10"
                                             FontFamily="{StaticResource SeerFontFamily}"
                                             FontSize="12"
                                             Foreground="{StaticResource SeerTextDim}"
                                             HeatMid="{StaticResource SeerText}"
                                             HeatHigh="{StaticResource SeerAccent}"
                                             PeakBrush="{StaticResource SeerPeak}" />
                    </Grid>
                </controls:HudPanel>

                <!-- [2] Memory Panel -->
                <controls:HudPanel x:Name="MemPanel" Grid.Row="0" Grid.Column="2"
                                   IndexTag="[2]" Header="MEMORY">
                    <Grid>
                        <StackPanel Margin="12,10">
                            <TextBlock Style="{StaticResource BaseTextStyle}">
                                <Run Text="Used:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="MemUsedValue" Text="-- / -- GB" />
                            </TextBlock>

                            <!-- The two biggest numbers on screen get a shape
                                 as well as digits. -->
                            <controls:SegmentMeter x:Name="MemUsedMeter"
                                                   Height="3" Margin="0,5,0,7"
                                                   Fill="{StaticResource SeerAccentSecondary}"
                                                   TrackBrush="{StaticResource SeerMeterTrack}" />
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Load:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="MemLoadValue" Text="-- %" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}">
                                <Run Text="Available:    " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="MemAvailValue" Text="-- GB" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </controls:HudPanel>

                <!-- [3] GPU Panel (spans full width on bottom row) -->
                <controls:HudPanel x:Name="GpuPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                   IndexTag="[3]" Header="GPU">
                    <Grid>
                        <Grid Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Column 0 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource BaseTextStyle}">
                                    <Run Text="Temperature:  " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuTempValue" Text="--" /><Run x:Name="GpuTempUnit" Text=" °C" />
                                </TextBlock>
                                <Path x:Name="GpuTempTrend" Width="7" Height="7" Stretch="Uniform"
                                      Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource BaseTextStyle}">
                                    <Run Text="Load:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuLoadValue" Text="--" /><Run x:Name="GpuLoadUnit" Text=" %" />
                                </TextBlock>
                                <Path x:Name="GpuLoadTrend" Width="7" Height="7" Stretch="Uniform"
                                      Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BaseTextStyle}">
                                <Run Text="Clock:        " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuClockValue" Text="--" /><Run x:Name="GpuClockUnit" Text=" MHz" />
                            </TextBlock>

                            <!-- Column 2 -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Hot Spot:     " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuHotSpotValue" Text="--" /><Run x:Name="GpuHotSpotUnit" Text=" °C" />
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Fan Speed:    " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuFanValue" Text="--" /><Run x:Name="GpuFanUnit" Text=" RPM" />
                            </TextBlock>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource BaseTextStyle}">
                                    <Run Text="VRAM:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="GpuVramValue" Text="-- / -- GB" />
                                </TextBlock>
                                <controls:SegmentMeter x:Name="GpuVramMeter"
                                                       Height="3" Margin="0,5,0,0"
                                                       Fill="{StaticResource SeerAccentTertiary}"
                                                       TrackBrush="{StaticResource SeerMeterTrack}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ Trend Charts ═══ -->
                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" /> <!-- Gap -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" /> <!-- Gap -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:TrendChart x:Name="CpuChart" Grid.Column="0" Title="CPU LOAD" Stroke="{StaticResource SeerAccent}" />
                    <controls:TrendChart x:Name="MemChart" Grid.Column="2" Title="MEM LOAD" Stroke="{StaticResource SeerAccentSecondary}" />
                    <controls:TrendChart x:Name="GpuChart" Grid.Column="4" Title="GPU LOAD" Stroke="{StaticResource SeerAccentTertiary}" />
                </Grid>

                <!-- ═══ Disk I/O Panel ═══ -->
                <controls:HudPanel x:Name="DiskPanel" Grid.Row="6" Grid.Column="0"
                                   IndexTag="[4]" Header="DISK I/O">
                    <Grid>
                        <StackPanel Margin="12,10,12,10">
                            <!-- Read -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle x:Name="DiskReadLed" Width="5" Height="5" Margin="0,0,7,0"
                                               Fill="{StaticResource SeerAccent}" Opacity="0.15" />
                                    <TextBlock Text="Read" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" />
                                </StackPanel>
                                <controls:SegmentMeter Grid.Column="1" x:Name="DiskReadMeter"
                                                       Height="4" VerticalAlignment="Center" Margin="0,0,12,0"
                                                       Max="1000" Scale="Log" LogFloor="0.05"
                                                       Fill="{StaticResource SeerText}"
                                                       TrackBrush="{StaticResource SeerMeterTrack}"
                                                       PeakBrush="{StaticResource SeerPeak}" />
                                <TextBlock Grid.Column="2" x:Name="DiskReadValue" Text="-- MB/s" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            
                            <!-- Write -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle x:Name="DiskWriteLed" Width="5" Height="5" Margin="0,0,7,0"
                                               Fill="{StaticResource SeerAccent}" Opacity="0.15" />
                                    <TextBlock Text="Write" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" />
                                </StackPanel>
                                <controls:SegmentMeter Grid.Column="1" x:Name="DiskWriteMeter"
                                                       Height="4" VerticalAlignment="Center" Margin="0,0,12,0"
                                                       Max="1000" Scale="Log" LogFloor="0.05"
                                                       Fill="{StaticResource SeerText}"
                                                       TrackBrush="{StaticResource SeerMeterTrack}"
                                                       PeakBrush="{StaticResource SeerPeak}" />
                                <TextBlock Grid.Column="2" x:Name="DiskWriteValue" Text="-- MB/s" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ Network I/O Panel ═══ -->
                <controls:HudPanel x:Name="NetPanel" Grid.Row="6" Grid.Column="2"
                                   IndexTag="[5]" Header="NETWORK I/O">
                    <Grid>
                        <StackPanel Margin="12,10,12,10">
                            <!-- Download -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle x:Name="NetDownLed" Width="5" Height="5" Margin="0,0,7,0"
                                               Fill="{StaticResource SeerAccent}" Opacity="0.15" />
                                    <TextBlock Text="Down" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" />
                                </StackPanel>
                                <controls:SegmentMeter Grid.Column="1" x:Name="NetDownMeter"
                                                       Height="4" VerticalAlignment="Center" Margin="0,0,12,0"
                                                       Max="1000" Scale="Log" LogFloor="0.05"
                                                       Fill="{StaticResource SeerText}"
                                                       TrackBrush="{StaticResource SeerMeterTrack}"
                                                       PeakBrush="{StaticResource SeerPeak}" />
                                <TextBlock Grid.Column="2" x:Name="NetDownValue" Text="-- Mbps" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            
                            <!-- Upload -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle x:Name="NetUpLed" Width="5" Height="5" Margin="0,0,7,0"
                                               Fill="{StaticResource SeerAccent}" Opacity="0.15" />
                                    <TextBlock Text="Up" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" />
                                </StackPanel>
                                <controls:SegmentMeter Grid.Column="1" x:Name="NetUpMeter"
                                                       Height="4" VerticalAlignment="Center" Margin="0,0,12,0"
                                                       Max="1000" Scale="Log" LogFloor="0.05"
                                                       Fill="{StaticResource SeerText}"
                                                       TrackBrush="{StaticResource SeerMeterTrack}"
                                                       PeakBrush="{StaticResource SeerPeak}" />
                                <TextBlock Grid.Column="2" x:Name="NetUpValue" Text="-- Mbps" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ Top Processes Panel ═══ -->
                <controls:HudPanel x:Name="ProcPanel" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                                   IndexTag="[6]" Header="TOP PROCESSES">
                    <Grid>
                        <ItemsControl x:Name="TopProcessesControl" Margin="12,10,12,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Rank change. Drawn rather than typed:
                                             an arrow glyph would fall back to
                                             another face if the monospace font
                                             is missing, at a different width. -->
                                        <Path Grid.Column="0"
                                              Width="6" Height="6"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RankMark}" Value="Up">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Data" Value="M 0,6 L 3,0 L 6,6 Z" />
                                                            <Setter Property="Fill" Value="{StaticResource SeerAccent}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RankMark}" Value="Down">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Data" Value="M 0,0 L 6,0 L 3,6 Z" />
                                                            <Setter Property="Fill" Value="{StaticResource SeerTextDim}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RankMark}" Value="New">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Data" Value="M 2,0 L 4,0 L 4,2 L 6,2 L 6,4 L 4,4 L 4,6 L 2,6 L 2,4 L 0,4 L 0,2 L 2,2 Z" />
                                                            <Setter Property="Fill" Value="{StaticResource SeerAccent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>

                                        <!-- Name (truncated) -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource BaseTextStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <controls:SegmentMeter Grid.Column="2"
                                                               Height="4"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"
                                                               Value="{Binding CpuPercent}"
                                                               Max="100"
                                                               Fill="{StaticResource SeerText}"
                                                               TrackBrush="{StaticResource SeerMeterTrack}" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CpuPercent, StringFormat={}{0,5:F1}%}"
                                                   Style="{StaticResource BaseTextStyle}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center" />

                                        <!-- RAM Value -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding WorkingSetMb, StringFormat={}{0,5:F0}MB}"
                                                   Style="{StaticResource BaseTextStyle}"
                                                   Foreground="{StaticResource SeerTextDim}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ Ping / Latency Panel ═══ -->
                <controls:HudPanel x:Name="PingPanel" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                                   IndexTag="[7]" Header="PING">
                    <controls:HudPanel.HeaderContent>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PingStateText"
                                       Text="STOPPED"
                                       Style="{StaticResource TagStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <!-- Unlike every other panel, this one sends
                                 traffic, so it stays off until started. -->
                            <Button x:Name="PingToggleButton"
                                    Content="START"
                                    Style="{StaticResource SeerActionButtonStyle}"
                                    Padding="10,0"
                                    Click="PingToggleButton_Click" />
                        </StackPanel>
                    </controls:HudPanel.HeaderContent>
                    <Grid>
                        <Grid Margin="12,10,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Host -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Host"
                                       Style="{StaticResource BaseTextStyle}"
                                       Foreground="{StaticResource SeerTextDim}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="PingHostBox"
                                     Style="{StaticResource SeerTextBoxStyle}"
                                     TextAlignment="Left"
                                     Margin="0,0,0,6" />

                            <!-- Latency + average -->
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Latency: " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="PingLatencyValue" Text="--" />
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="3"
                                       Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Average: " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="PingAverageValue" Text="--" />
                            </TextBlock>

                            <!-- Jitter + loss -->
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Style="{StaticResource BaseTextStyle}">
                                <Run Text="Jitter:  " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="PingJitterValue" Text="--" />
                            </TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="3"
                                       Style="{StaticResource BaseTextStyle}">
                                <Run Text="Loss:    " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="PingLossValue" Text="--" />
                            </TextBlock>

                            <!-- One bar per reply, newest on the right, with
                                 losses as red hairlines. Jitter has a shape
                                 that an average can't show. -->
                            <controls:PingTape Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                               x:Name="PingTapeStrip"
                                               Height="22"
                                               Margin="0,12,0,0"
                                               Fill="{StaticResource SeerAccent}"
                                               LatestBrush="{StaticResource SeerPeak}"
                                               LossBrush="{StaticResource SeerDanger}" />
                        </Grid>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ Alerts Panel (collapsed by default) ═══ -->
                <controls:HudPanel x:Name="EventsPanel" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3"
                                   IndexTag="[8]" Header="EVENTS"
                                   IsExpandable="True" IsExpanded="False">
                    <Grid>
                        <!-- Collapsing is the panel's own state now: the
                             header line toggles IsExpanded and the template
                             drops the body, so there is no handler here. -->
                        <ScrollViewer x:Name="AlertsContent" Margin="12,10" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AlertsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" /> <!-- Time -->
                                                <ColumnDefinition Width="80" /> <!-- Metric -->
                                                <ColumnDefinition Width="*" />  <!-- Value -->
                                                <ColumnDefinition Width="Auto" /> <!-- Severity Badge -->
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- The timestamp is the one place
                                                 the peak accent appears in text:
                                                 it marks when, not what. -->
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerPeak}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource BaseTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource BaseTextStyle}" Foreground="{StaticResource SeerTextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            
                                            <!-- 4px, matching the status badge in the
                                                 status strip. The design system allows
                                                 status indicators the only exception to
                                                 the sharp-corners rule, but specifies
                                                 slight rounding — not a full capsule. -->
                                            <Border Grid.Column="3" 
                                                    BorderThickness="1" 
                                                    CornerRadius="4" 
                                                    Padding="8,1" 
                                                    HorizontalAlignment="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource SeerWarning}" />
                                                        <Setter Property="Background" Value="{StaticResource SeerWarningTint}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                <Setter Property="BorderBrush" Value="{StaticResource SeerDanger}" />
                                                                <Setter Property="Background" Value="{StaticResource SeerDangerTint}" />
                                                            </DataTrigger>
                                                            <!-- Ordinary events carry no badge: a badge on
                                                                 everything would say nothing. -->
                                                            <DataTrigger Binding="{Binding HasSeverity}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Severity}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TagStyle}">
                                                            <Setter Property="Foreground" Value="{StaticResource SeerWarning}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                    <Setter Property="Foreground" Value="{StaticResource SeerDanger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </controls:HudPanel>

                <!-- ═══ System Info Panel (collapsed by default) ═══ -->
                <controls:HudPanel x:Name="SysInfoPanel" Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3"
                                   IndexTag="[i]" Header="SYSTEM INFO"
                                   IsExpandable="True" IsExpanded="False">
                    <Grid>
                        <StackPanel x:Name="SystemInfoContent" Margin="12,10">
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Motherboard:  " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysMotherboard" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="BIOS:         " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysBios" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="CPU:          " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysCpu" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="Cores:        " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysCores" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="RAM:          " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysRam" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4">
                                <Run Text="DIMM Slots:   " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysDimmSlots" Text="--" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource BaseTextStyle}">
                                <Run Text="GPU:          " Foreground="{StaticResource SeerTextDim}" /><Run x:Name="SysGpu" Text="--" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </controls:HudPanel>
            </Grid>
            </ScrollViewer>

            <!-- ═══ Status line ═══
                 What Seer costs to run, how long the machine has been up,
                 whether sensors are reachable, and the last thing that
                 happened. Outside the ScrollViewer: it describes the session,
                 not the panels. -->
            <Border x:Name="StatusLine" Grid.Row="3"
                    Background="{StaticResource SeerPanel}"
                    BorderBrush="{StaticResource SeerBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusPollText" Grid.Column="0"
                               Style="{StaticResource TagStyle}" />
                    <TextBlock x:Name="StatusUptimeText" Grid.Column="1"
                               Style="{StaticResource TagStyle}" Margin="16,0,0,0" />
                    <TextBlock x:Name="StatusElevationText" Grid.Column="2"
                               Style="{StaticResource TagStyle}" Margin="16,0,0,0" />
                    <TextBlock x:Name="StatusEventText" Grid.Column="3"
                               Style="{StaticResource TagStyle}" Margin="16,0,16,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusClockText" Grid.Column="4"
                               Style="{StaticResource TagStyle}"
                               Foreground="{StaticResource SeerText}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
