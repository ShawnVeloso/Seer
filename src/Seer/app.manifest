<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="MyApplication.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          LibreHardwareMonitorLib requires elevated privileges to read
          hardware sensors (CPU temps, GPU metrics, fan speeds, etc.).
          This is a fundamental Windows constraint — the underlying
          WinRing0/kernel drivers need admin access.

          For a 24/7 background tool, a future architecture may split
          into an elevated service + unprivileged UI. For now, the
          entire app requests elevation.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
