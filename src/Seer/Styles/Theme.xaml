<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Seer.Controls">

    <!-- ═══════════════════════════════════════════════════════════════
         Seer Design System — WPF Resource Dictionary
         Source of truth: seer_design_system.md

         All colors, typography, and structural styles live here.
         Never hardcode hex values in individual XAML files — reference
         these resources instead.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Backgrounds & Panels ── -->
    <Color x:Key="BgColor">#FF08080A</Color>
    <Color x:Key="PanelColor">#FF0E0E11</Color>
    <SolidColorBrush x:Key="SeerBackground" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SeerPanel" Color="{StaticResource PanelColor}" />

    <!-- ── Borders ── -->
    <Color x:Key="BorderColor">#FF2A2A2E</Color>
    <Color x:Key="BorderActiveColor">#FF4DD8FF</Color>
    <SolidColorBrush x:Key="SeerBorder" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SeerBorderActive" Color="{StaticResource BorderActiveColor}" />

    <!-- ── Typography Colors ── -->
    <Color x:Key="TextColor">#FFC9C9CE</Color>
    <Color x:Key="TextDimColor">#FF6A6A70</Color>
    <SolidColorBrush x:Key="SeerText" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SeerTextDim" Color="{StaticResource TextDimColor}" />

    <!-- ── Accent / Channel Colors ── -->
    <Color x:Key="AccentColor">#FF4DD8FF</Color>
    <Color x:Key="AccentSecondaryColor">#FF5B8DFF</Color>
    <Color x:Key="AccentTertiaryColor">#FFB083FF</Color>
    <Color x:Key="SuccessColor">#FF3DDC84</Color>
    <Color x:Key="WarningColor">#FFFFB020</Color>
    <Color x:Key="DangerColor">#FFFF5C5C</Color>
    <SolidColorBrush x:Key="SeerAccent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SeerAccentSecondary" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="SeerAccentTertiary" Color="{StaticResource AccentTertiaryColor}" />
    <SolidColorBrush x:Key="SeerSuccess" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SeerWarning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SeerDanger" Color="{StaticResource DangerColor}" />

    <!-- ── Peak / event accent ──
         Magenta, reserved for peak-hold ticks and event timestamps. Never a
         fill, never a border: it sits between the GPU channel's violet and
         the critical red, so anything larger than a 1px tick or a 9px
         timestamp starts reading as a third alarm colour. -->
    <Color x:Key="PeakColor">#FFFF4FB0</Color>
    <SolidColorBrush x:Key="SeerPeak" Color="{StaticResource PeakColor}" />
    <SolidColorBrush x:Key="SeerPeakTint" Color="#26FF4FB0" />

    <!-- ── Tints ──
         10% washes for badge and tab backgrounds. The severity tints replace
         hand-written literals (#1AF59E0B, #1AEF4444) that had drifted from
         the very tokens they were meant to be derived from. -->
    <SolidColorBrush x:Key="SeerAccentTint" Color="#1A4DD8FF" />
    <SolidColorBrush x:Key="SeerSuccessTint" Color="#1A3DDC84" />
    <SolidColorBrush x:Key="SeerWarningTint" Color="#1AFFB020" />
    <SolidColorBrush x:Key="SeerDangerTint" Color="#1AFF5C5C" />

    <!-- ── Halos ──
         The soft outer light, drawn as a wider low-opacity stroke beneath the
         real one rather than as a DropShadowEffect. An effect forces an
         intermediate render target every time its subtree invalidates, which
         on a chart that redraws every second is a recurring cost for what
         looks like a static glow. -->
    <SolidColorBrush x:Key="SeerAccentHalo" Color="#2E4DD8FF" />
    <SolidColorBrush x:Key="SeerWarningHalo" Color="#2EFFB020" />
    <SolidColorBrush x:Key="SeerDangerHalo" Color="#2EFF5C5C" />

    <!-- The unfilled part of a meter. Dim enough to read as a track rather
         than as data, bright enough that an idle meter still looks like one
         instead of looking broken. -->
    <SolidColorBrush x:Key="SeerMeterTrack" Color="#FF34343B" />

    <!-- ── Typography ── -->
    <!--
        Font stack: JetBrains Mono → Consolas → Courier New
        WPF resolves the first installed font in the family list.
        JetBrains Mono must be installed system-wide to be picked up.
    -->
    <FontFamily x:Key="SeerFontFamily">JetBrains Mono, Cascadia Code, Consolas, GlobalMonospace</FontFamily>

    <!-- Base text: 13px, line-height ~1.6 (not directly settable in WPF,
         but TextBlock.LineHeight can approximate it) -->
    <Style x:Key="BaseTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SeerFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SeerText}" />
    </Style>

    <!-- Dim / secondary text -->
    <Style x:Key="DimTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource SeerTextDim}" />
    </Style>

    <!-- Panel headers: 11px, weight 600 (SemiBold), uppercase, letter-spacing 0.08em
         WPF doesn't have letter-spacing, but CharacterSpacing is available in some controls.
         We approximate with SemiBold + uppercase in the XAML content itself. -->
    <Style x:Key="PanelHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SeerTextDim}" />
    </Style>

    <!-- Tags & metadata: 9-10px, uppercase -->
    <Style x:Key="TagStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SeerTextDim}" />
    </Style>

    <!-- Panel title and meta sit ON the top border line rather than in a row
         below it. Each carries the panel background as a knockout: the border
         passes behind the text and the backplate hides the segment it would
         otherwise strike through. -->
    <Style x:Key="PanelTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SeerTextDim}" />
        <Setter Property="Background" Value="{StaticResource SeerPanel}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PanelMetaStyle" TargetType="TextBlock" BasedOn="{StaticResource TagStyle}">
        <Setter Property="Background" Value="{StaticResource SeerPanel}" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Wordmark style for "SEER" in the title bar -->
    <Style x:Key="WordmarkStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SeerFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource SeerAccent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Structural Styles ── -->

    <!-- HudPanel: the chrome every panel wears.

         The title and meta sit ON the top border line instead of in a row
         beneath it, which gives back roughly a header row per panel across
         nine panels. The top-right corner is cut at 45°, so the outline is a
         ChamferShape rather than a Border — a Border can round a corner but
         cannot cut one.

         Every state colour here is a StaticResource resolved when the theme
         loads. The control itself resolves nothing by string, so a renamed
         token fails loudly at load instead of silently the first time a panel
         is hovered. -->
    <Style TargetType="{x:Type controls:HudPanel}">
        <Setter Property="EdgeBrush" Value="{StaticResource SeerBorder}" />
        <Setter Property="AccentBrush" Value="{StaticResource SeerBorderActive}" />
        <Setter Property="HaloBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HudPanel}">
                    <Grid>
                        <!-- Halo: a wider, low-opacity outline beneath the real
                             one. Transparent until something lights it up. -->
                        <controls:ChamferShape x:Name="PART_Halo"
                                               Chamfer="{TemplateBinding Chamfer}"
                                               Stroke="{TemplateBinding HaloBrush}"
                                               StrokeThickness="3" />

                        <controls:ChamferShape x:Name="PART_Edge"
                                               Chamfer="{TemplateBinding Chamfer}"
                                               Fill="{StaticResource SeerPanel}"
                                               Stroke="{TemplateBinding EdgeBrush}"
                                               StrokeThickness="1" />

                        <!-- The top margin clears the header line, which is
                             centred on the top edge. -->
                        <ContentPresenter x:Name="PART_Content" Margin="1,9,1,1" />

                        <!-- Corner brackets, hidden until they mean something:
                             hover, or a panel whose readings left nominal.
                             There is no top-right bracket — the chamfer has
                             that corner. -->
                        <Grid x:Name="BracketGrid" Opacity="0">
                            <Path Stroke="{TemplateBinding AccentBrush}" StrokeThickness="1" Data="M 0,6 L 0,0 L 6,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-1,0,0" />
                            <Path Stroke="{TemplateBinding AccentBrush}" StrokeThickness="1" Data="M 0,-6 L 0,0 L 6,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-1,0,0,-1" />
                            <Path Stroke="{TemplateBinding AccentBrush}" StrokeThickness="1" Data="M -6,0 L 0,0 L 0,-6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" />
                        </Grid>

                        <!-- Header line: index and title on the left, meta and
                             any panel-specific control on the right, each
                             knocking a gap in the border it sits on. The right
                             margin clears the chamfer. Background is explicitly
                             Transparent so the whole strip is hit-testable for
                             collapsible panels. -->
                        <Grid x:Name="PART_HeaderLine"
                              VerticalAlignment="Top"
                              Height="14"
                              Margin="10,-7,16,0"
                              Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Background="{StaticResource SeerPanel}">
                                <Border x:Name="PART_IndexTab"
                                        Background="{StaticResource SeerAccentTint}"
                                        Padding="3,0">
                                    <TextBlock Text="{TemplateBinding IndexTag}"
                                               Style="{StaticResource TagStyle}"
                                               Foreground="{StaticResource SeerAccent}"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{TemplateBinding Header}"
                                           Style="{StaticResource PanelTitleStyle}" />
                                <Path x:Name="Expander"
                                      Data="M 0,0 L 4,3.5 L 0,7 Z"
                                      Fill="{StaticResource SeerTextDim}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Visibility="Collapsed"
                                      RenderTransformOrigin="0.5,0.5" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Background="{StaticResource SeerPanel}">
                                <TextBlock Text="{TemplateBinding Meta}"
                                           Style="{StaticResource PanelMetaStyle}" />
                                <ContentPresenter Content="{TemplateBinding HeaderContent}"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- A collapsed panel keeps its header line and loses
                             its body, so the row shrinks to a titled rule. -->
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="PART_Content" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsExpandable" Value="True">
                            <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpandable" Value="True" />
                                <Condition Property="IsExpanded" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Expander" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="EdgeBrush" Value="{StaticResource SeerBorderActive}" />
                            <Setter Property="AccentBrush" Value="{StaticResource SeerBorderActive}" />
                            <Setter Property="HaloBrush" Value="{StaticResource SeerAccentHalo}" />
                            <Setter TargetName="BracketGrid" Property="Opacity" Value="1" />
                        </Trigger>

                        <!-- Severity outranks hover: a warning panel stays
                             amber under the cursor rather than reverting to
                             the hover colour and hiding its own state. -->
                        <Trigger Property="Severity" Value="Warning">
                            <Setter Property="EdgeBrush" Value="{StaticResource SeerWarning}" />
                            <Setter Property="AccentBrush" Value="{StaticResource SeerWarning}" />
                            <Setter Property="HaloBrush" Value="{StaticResource SeerWarningHalo}" />
                            <Setter TargetName="BracketGrid" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Critical">
                            <Setter Property="EdgeBrush" Value="{StaticResource SeerDanger}" />
                            <Setter Property="AccentBrush" Value="{StaticResource SeerDanger}" />
                            <Setter Property="HaloBrush" Value="{StaticResource SeerDangerHalo}" />
                            <Setter TargetName="BracketGrid" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar button style (minimize, maximize, close) -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SeerText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource SeerFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close button — red on hover -->
    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SeerDanger}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#CCFF5C5C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Input controls ══════════════════════════════════════════════
         Added for the Settings window. Sharp corners and hairline
         borders, per the design system: structure is never rounded. -->

    <Style x:Key="SeerTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource SeerFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SeerText}" />
        <Setter Property="CaretBrush" Value="{StaticResource SeerAccent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource SeerAccent}" />
        <Setter Property="Background" Value="{StaticResource SeerBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SeerBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SeerTextDim}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SeerBorderActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SeerCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource SeerFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SeerText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="14" Height="14"
                                CornerRadius="0"
                                BorderThickness="1"
                                BorderBrush="{StaticResource SeerBorder}"
                                Background="{StaticResource SeerBackground}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Mark"
                                       Text="×"
                                       FontFamily="{StaticResource SeerFontFamily}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SeerAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SeerAccent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SeerBorderActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text-style action button (SAVE / CANCEL) -->
    <Style x:Key="SeerActionButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SeerFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SeerTextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="0"
                            BorderThickness="1"
                            BorderBrush="{StaticResource SeerBorder}"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SeerAccent}" />
                            <Setter Property="Foreground" Value="{StaticResource SeerAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SeerAccentTint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Scrollbar ═══════════════════════════════════════════════════
         The stock WPF scrollbar (raised buttons, wide grey track) would
         be the only piece of default chrome in the whole app. This is a
         thin overlay bar: no arrows, no visible track, sharp corners. -->

    <Style x:Key="SeerScrollBarStyle" TargetType="ScrollBar">
        <!-- 10px of hit area, but only 4px of visible thumb: easy enough
             to grab, thin enough not to read as chrome. -->
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <!-- No RepeatButtons: the arrows add nothing and
                             cost 34px of the visible bar. -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- The one rounded element in
                                                 the app. Panels stay sharp
                                                 per the design system; a
                                                 hairline scrollbar reads
                                                 better as a soft capsule. -->
                                            <Border x:Name="ThumbBorder"
                                                    Background="{StaticResource SeerTextDim}"
                                                    CornerRadius="2"
                                                    Opacity="0.45"
                                                    Margin="3,2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource SeerAccent}" />
                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource SeerAccent}" />
                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Applies the bar style to any ScrollViewer using this key. -->
    <Style x:Key="SeerScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollContentPresenter Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />

                        <ScrollBar Grid.Column="1"
                                   x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource SeerScrollBarStyle}"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
